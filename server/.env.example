# Copy to server/.env for local dev. In production (Render etc.) set these as
# real environment variables instead of committing a file.
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development                 # set to "production" when deployed
PORT=5000                            # Render/Heroku inject their own PORT
CLIENT_URL=http://localhost:5173     # in prod: your public URL, e.g. https://ca-firm-saas.onrender.com

# Extra browser origins allowed to call the API cross-origin, comma-separated.
# Leave empty for the normal single-origin deploy (API + frontend on one host).
# Only needed if you host the frontend on a DIFFERENT domain than the backend.
CORS_ORIGINS=

# Database — MongoDB Atlas connection string (free M0 tier is fine)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ca-firm-saas?retryWrites=true&w=majority

# JWT — use long random strings in production (Render can auto-generate them)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_EMAIL_SECRET=change-me-email-secret

# Cookies — leave BLANK for a single-host deploy (host-only cookie, just works).
# Only set this if the auth cookie must span subdomains (api.x.com + app.x.com).
COOKIE_DOMAIN=

# Cloudinary — required for document / receipt uploads to work (free tier fine).
# Leave blank to run without uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail (SMTP) — optional. Blank = emails (verify / reset / reminders) are
# skipped silently. Use a free provider like Brevo to enable them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="CA Firm SaaS <no-reply@example.com>"

# Rate limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Seed / bootstrap first account (optional — used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_FIRM_NAME=Demo & Associates
